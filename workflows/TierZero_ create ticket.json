        0,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Check ticket rules: limits the AI cannot talk its way past\nconst CATEGORIES = [\"account\", \"network\", \"hardware\", \"software\", \"ai_tools\", \"security\", \"other\"];\nconst SUSPICIOUS = /ignore (all |any |your |the )?(previous |prior |above )?(instructions|rules)|you are now|system (message|prompt|override)|developer mode|admin mode|new instructions/i;\n\nconst t = $input.first().json;\nconst asked = String(t.priority ?? \"\").toLowerCase().trim();\nconst category = String(t.category ?? \"\").toLowerCase().trim().replace(/\\s+/g, \"_\");  // \"AI Tools\" becomes \"ai_tools\"\nconst flagged = SUSPICIOUS.test(`${t.user_message ?? \"\"} ${t.summary ?? \"\"}`);\n\nlet summary = String(t.summary ?? \"\").slice(0, 1000);        // keep summaries a sensible length\nif (asked === \"high\") summary = \"[AI suggested high priority] \" + summary;\nif (flagged) summary = \"[Needs review: this request contained text aimed at the AI] \" + summary;\n\nreturn [{\n  json: {\n    // a blank session never matches another blank session, so it cannot block a ticket\n    session_id: String(t.session_id ?? \"\").trim() || `no-session-${$execution.id}`,\n    summary,\n    category: CATEGORIES.includes(category) ? category : \"other\",     // unknown values become \"other\"\n    priority: asked === \"low\" ? \"low\" : \"medium\",                       // never high: a technician decides that\n    needs_review: flagged || asked === \"high\",\n    source: String(t.source ?? \"unknown\"),                             // \"test\" rows are easy to clear later\n  },\n}];"
      },
      "id": "4715c5a4-85b3-4701-b1f4-24d96d9b6c74",
      "name": "Check ticket rules",
